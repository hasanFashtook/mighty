repositories:
  # ==============================================================================
  # MIGHTY ROS 2 Lyrical (Ubuntu 26.04) & Gazebo Sim (Harmonic) Dependencies
  # ==============================================================================

  # Mapping pipeline (synchronized sim clocks, SensorDataQoS, GCC 15 ported)
  acl-mapping:
    type: git
    url: https://github.com/hasanFashtook/acl-mapping.git
    version: ros2-lyrical

  # Convex decomposition library (C++20 & GCC 15 ported)
  DecompROS2:
    type: git
    url: https://github.com/hasanFashtook/DecompROS2.git
    version: ros2-lyrical

  # Simulation sensors & map generator utilities (GCC 15 ported)
  uav_simulator:
    type: git
    url: https://github.com/hasanFashtook/uav_simulator.git
    version: ros2-lyrical

  # Custom ROS 2 message definitions
  dynus_interfaces:
    type: git
    url: https://github.com/kotakondo/dynus_interfaces.git
    version: 628a682c6a12b07fb2be7cffb4782ccdfe5b323d

  # ==============================================================================
  # Note on Gazebo Classic Dependencies:
  # The following legacy Gazebo Classic packages are NO LONGER NEEDED in ROS 2 Lyrical:
  #   - gazebo_ros_pkgs (replaced by ros-lyrical-ros-gz-sim & ros_gz_bridge)
  #   - livox_laser_simulation_ros2 (replaced by native Gz Sim GPU LiDAR sensor)
  #   - realsense_gazebo_plugin (omitted in favor of native GPU LiDAR)
  #
  # Native simulation packages are installed via apt:
  #   sudo apt install -y ros-lyrical-ros-gz-sim ros-lyrical-ros-gz-bridge ros-lyrical-ros-gz-interfaces
  # ==============================================================================

  # Hardware-only Livox dependencies (Optional: only needed when testing on physical drone)
  livox_ros_driver2:
    type: git
    url: https://github.com/kotakondo/livox_ros_driver2.git
    version: 274aad204b5dfce15c648e88dfd375fa5d7b3026
  Livox-SDK2:
    type: git
    url: https://github.com/Livox-SDK/Livox-SDK2.git
    version: 6a940156dd7151c3ab6a52442d86bc83613bd11b
